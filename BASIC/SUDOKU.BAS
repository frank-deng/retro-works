10 DEFINT A-Z:DIM BT(15),BTN(15),B(9,9),BG(9,9),MX(9),MY(9),MG(9)
11 DIM T(81,3),ST(81)
12 TL=0:FOR I=0 TO 14:BT(I)=2^I:BTN(I)=NOT(BT(I)):NEXT I
13 FOR Y=0 TO 8:FOR X=0 TO 8:BG(Y,X)=(Y\3)*3+(X\3):NEXT X:NEXT Y
20 INPUT "Load from file? (Y/N)",F$:IF F$="y" OR F$="Y" THEN GOTO 40
30 PRINT "Input sudoku:":FOR Y=0 TO 8:GOSUB 130:NEXT Y:GOTO 50
40 INPUT "Filename:",F$:OPEN F$ FOR INPUT AS #1:Y=0
45 WHILE NOT EOF(1):INPUT#1,S$:GOSUB 140:Y=Y+1:WEND:CLOSE #1
50 WHILE 1:CLS:GOSUB 160:FOR I=0 TO 9:MX(I)=0:MY(I)=0:MG(I)=0:NEXT I
60 FOR Y=0 TO 8:FOR X=0 TO 8:N=B(Y,X):G=BG(Y,X):IF N=0 THEN GOTO 100
70 M=BT(N):DUP=(M AND MX(X))OR(M AND MY(Y))OR(M AND MG(G))
80 IF DUP<>0 THEN PRINT "Duplicated number at row";Y+1;", column";X+1:GOTO 110
90 MX(X)=MX(X) OR M:MY(Y)=MY(Y) OR M:MG(G)=MG(G) OR M
100 NEXT X:NEXT Y
110 INPUT "[C]ompute, [S]ave, [E]dit, [Q]uit: ";K$
111 IF (K$="C" OR K$="c") AND E=0 THEN GOTO 200
112 IF K$="S" OR K$="s" THEN GOSUB 150
113 IF K$="E" OR K$="e" THEN GOSUB 120
114 IF K$="Q" OR K$="q" THEN END
119 WEND
120 INPUT "Which line (1-9)";Y:Y=Y-1:IF Y<0 OR Y>8 THEN RETURN
130 PRINT Y+1;:INPUT ": ",S$
140 L=LEN(S$):IF L>9 THEN L=9
145 FOR X=0 TO L-1:B(Y,X)=INSTR(1,"123456789",MID$(S$,X+1,1)):NEXT X
149 RETURN
150 INPUT "Filename:",F$:OPEN F$ FOR OUTPUT AS #1:FOR Y=0 TO 8:FOR X=0 TO 7
155 PRINT#1,HEX$(B(Y,X));:NEXT X:PRINT#1,HEX$(B(Y,8)):NEXT Y
159 CLOSE #1:RETURN
160 FOR Y=0 TO 8:FOR X=0 TO 8:PRINT USING "# ";B(Y,X);
161 IF (X MOD 3)=2 THEN PRINT " ";
162 NEXT X:PRINT "":IF (Y MOD 3)=2 THEN PRINT ""
163 NEXT Y:RETURN
200 PRINT "Calculating...";
210 FOR I=0 TO 9:MX(I)=0:MY(I)=0:MG(I)=0:NEXT I
220 TL=0:FOR Y=0 TO 8:FOR X=0 TO 8:N=B(Y,X):G=BG(Y,X):M=BT(N)
230 IF N=0 THEN T(TL,0)=X:T(TL,1)=Y:T(TL,2)=G:TL=TL+1 ELSE MX(X)=MX(X) OR M:MY(Y)=MY(Y) OR M:MG(G)=MG(G) OR M
240 NEXT X:NEXT Y
250 RN=1:WHILE RN=1 AND TL>0:RN=0:P=0:FOR I=0 TO TL-1
260 X=T(I,0):Y=T(I,1):G=T(I,2):M=NOT(MX(X) OR MY(Y) OR MG(G)) AND &H3FE
270 IF M=0 THEN PRINT "No answer":END
280 IF (M AND (M-1))<>0 THEN T(P,0)=T(I,0):T(P,1)=T(I,1):T(P,2)=T(I,2):P=P+1:GOTO 310
290 RN=1:MX(X)=MX(X) OR M:MY(Y)=MY(Y) OR M:MG(G)=MG(G) OR M
300 FOR N=1 TO 9:IF BT(N)=M THEN B(Y,X)=N:GOTO 310
301 NEXT N
310 NEXT I:TL=P:WEND:IF TL=0 THEN GOTO 500
320 FOR I=0 TO TL-1:X=T(I,0):Y=T(I,1):G=T(I,2)
330 T(I,3)=NOT(MX(X) OR MY(Y) OR MG(G)) AND &H3FE:NEXT I
340 FOR I=0 TO 9:MX(I)=0:MY(I)=0:MG(I)=0:NEXT I:PRINT ".";
350 SP=0:WHILE SP<TL
360 C0=100:FOR I=0 TO TL-1:X=T(I,0):Y=T(I,1):G=T(I,2)
370 IF B(Y,X)<>0 THEN GOTO 400
380 M=T(I,3) AND NOT(MX(X) OR MY(Y) OR MG(G)):IF M=0 THEN GOTO 410
390 C=0:WHILE M>0:M=M AND(M-1):C=C+1:WEND:IF C<C0 THEN C0=C:ST(SP)=I
400 NEXT I:SP=SP+1
410 N=0:SP=SP+1:WHILE N=0 AND SP>0:SP=SP-1:I=ST(SP-1)
420 X=T(I,0):Y=T(I,1):G=T(I,2):N=B(Y,X)
430 IF N<>0 THEN M=BTN(N):MX(X)=MX(X) AND M:MY(Y)=MY(Y) AND M:MG(G)=MG(G) AND M
440 BM=T(I,3) AND NOT(MX(X) OR MY(Y) OR MG(G))
450 N=N+1:WHILE N<=9 AND (BT(N) AND BM)=0:N=N+1:WEND:IF N>9 THEN N=0
460 B(Y,X)=N:WEND:IF SP<=0 THEN PRINT "No answer":END
470 M=BT(N):MX(X)=MX(X) OR M:MY(Y)=MY(Y) OR M:MG(G)=MG(G) OR M:WEND
500 PRINT "Complete.":GOSUB 160:END

