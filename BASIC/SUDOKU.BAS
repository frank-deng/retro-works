10 DEFINT A-Z:DIM B(9,9),BG(9,9),BT(15),BTN(15),MX(9),MY(9),MG(9),T(81,3),ST(81,1)
11 TL=0:FOR I=0 TO 14:BT(I)=2^I:BTN(I)=NOT(BT(I)):NEXT I
12 FOR Y=0 TO 8:FOR X=0 TO 8:BG(Y,X)=(Y\3)*3+(X\3):NEXT X:NEXT Y
20 INPUT "Load from file? (Y/N)",F$:IF F$="y" OR F$="Y" THEN GOSUB 300 ELSE GOSUB 320
30 GOSUB 360:PRINT "Calculating...";
40 RN=1:WHILE RN=1 AND TL>0:RN=0:P=0
50 FOR I=0 TO TL-1:X=T(I,0):Y=T(I,1):G=T(I,2)
60 M=NOT(MX(X) OR MY(Y) OR MG(G)) AND &H3FE:IF M=0 THEN PRINT "No answer":END
70 IF (M AND (M-1))<>0 THEN T(P,0)=T(I,0):T(P,1)=T(I,1):T(P,2)=T(I,2):P=P+1:GOTO 100
80 RN=1:MX(X)=MX(X) OR M:MY(Y)=MY(Y) OR M:MG(G)=MG(G) OR M
90 FOR N=1 TO 9:IF BT(N)=M THEN B(Y,X)=N:GOTO 100
91 NEXT N
100 NEXT I:TL=P:WEND:IF TL=0 THEN PRINT "Complete.":GOSUB 250:END
110 FOR I=0 TO TL-1:X=T(I,0):Y=T(I,1):G=T(I,2)
120 T(I,3)=NOT(MX(X) OR MY(Y) OR MG(G)) AND &H3FE:NEXT I
130 FOR I=0 TO 9:MX(I)=0:MY(I)=0:MG(I)=0:NEXT I:PRINT ".";
150 SP=0:WHILE SP<TL:GOSUB 500:IF SP=0 THEN PRINT "No answer":END
210 WEND:PRINT "Complete.":GOSUB 250:END
250 FOR Y=0 TO 8:FOR X=0 TO 8:N=B(Y,X)
251 PRINT USING "# ";B(Y,X);:IF (X MOD 3)=2 THEN PRINT " ";
252 NEXT X:PRINT "":IF (Y MOD 3)=2 THEN PRINT ""
253 NEXT Y:RETURN
300 INPUT "Filename:",F$:OPEN F$ FOR INPUT AS #1:Y=0:WHILE NOT EOF(1)
301 INPUT#1,S$:IF LEN(S$)=9 THEN GOSUB 350:Y=Y+1
302 WEND:CLOSE #1:RETURN
310 INPUT "Filename:",F$:OPEN F$ FOR OUTPUT AS #1:FOR Y=0 TO 8:FOR X=0 TO 7
311 PRINT#1,HEX$(B(Y,X));:NEXT X:PRINT#1,HEX$(B(Y,8)):NEXT Y:CLOSE #1:RETURN
320 PRINT "Input sudoku:":FOR Y=0 TO 8:GOSUB 340:NEXT Y:RETURN
330 INPUT "Which line (1-9)";Y:IF Y<1 OR Y>9 THEN RETURN ELSE Y=Y-1
340 E=1:WHILE E<>0:PRINT Y+1;:INPUT ": ",S$
341 IF LEN(S$)<>9 THEN PRINT "Invalid Input" ELSE E=0
342 WEND
350 FOR X=0 TO 8:B(Y,X)=INSTR(1,"123456789",MID$(S$,X+1,1)):NEXT X:RETURN
360 WHILE 1:CLS:GOSUB 250:GOSUB 400
370 IF E<>0 THEN PRINT "Duplicated number at row";Y+1;", column";X+1
380 INPUT "[C]ompute, [S]ave, [E]dit, [Q]uit: ";K$
381 IF (K$="C" OR K$="c") AND E=0 THEN RETURN
382 IF K$="S" OR K$="s" THEN GOSUB 310
383 IF K$="E" OR K$="e" THEN GOSUB 330
384 IF K$="Q" OR K$="q" THEN END
389 WEND
400 E=0:FOR I=0 TO 9:MX(I)=0:MY(I)=0:MG(I)=0:NEXT I
410 TL=0:FOR Y=0 TO 8:FOR X=0 TO 8:N=B(Y,X):G=BG(Y,X)
420 IF N=0 THEN T(TL,0)=X:T(TL,1)=Y:T(TL,2)=G:TL=TL+1:GOTO 490
430 M=BT(N):DUP=(M AND MX(X))OR(M AND MY(Y))OR(M AND MG(G))
440 IF DUP<>0 THEN E=1:RETURN
450 MX(X)=MX(X) OR M:MY(Y)=MY(Y) OR M:MG(G)=MG(G) OR M
490 NEXT X:NEXT Y:RETURN
500 C0=100:FOR I=0 TO TL-1:X=T(I,0):Y=T(I,1):G=T(I,2)
510 IF B(Y,X)<>0 THEN GOTO 540
520 M=T(I,3) AND NOT(MX(X) OR MY(Y) OR MG(G)):R=0
525 C=0:WHILE M>0:M=M AND (M-1):C=C+1:WEND
530 IF C=0 THEN GOTO 600 ELSE IF C<C0 THEN C0=C:ST(SP,0)=I
540 NEXT I:SP=SP+1
600 N=0:SP=SP+1:WHILE N=0 AND SP>0:SP=SP-1:I=ST(SP-1,0)
610 X=T(I,0):Y=T(I,1):G=T(I,2):N=B(Y,X)
620 IF N<>0 THEN M=BTN(N):MX(X)=MX(X) AND M:MY(Y)=MY(Y) AND M:MG(G)=MG(G) AND M
630 BM=T(I,3) AND NOT(MX(X) OR MY(Y) OR MG(G))
640 N=N+1:WHILE N<=9 AND (BT(N) AND BM)=0:N=N+1:WEND:IF N>9 THEN N=0
650 B(Y,X)=N:WEND:IF SP<=0 THEN RETURN
670 M=BT(N):MX(X)=MX(X) OR M:MY(Y)=MY(Y) OR M:MG(G)=MG(G) OR M
680 RETURN

